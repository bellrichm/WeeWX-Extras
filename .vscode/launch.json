{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "buildConfig",
            "type": "python",
            "request": "launch",
            "program": "utils/buildConfig.py",
            "console": "integratedTerminal",
            "args": [
                "--template", "${userHome}/weewx/src/weewx_data/weewx.conf",
                "--dir", "${userHome}/weewx_code/configs/extensions/",
                "--server", "${userHome}/weewx_code/configs/extensions/server/development.conf",
                "--secrets", "${userHome}/weewx_code/secrets/rmbellv01/mqttreplicate.secrets.conf",
                "${userHome}/weewx-data/weewx.conf",
                "--add-stdreport", "develop.conf,jas.conf,jas-mem.conf,jas-monitor.conf,aws.conf",
                "--no-backup",
            ],                                    
        },                
        {
            "name": "Pushover",
            "type": "python",
            "request": "launch",
            "program": "bin/user/pushover.py",
            "console": "integratedTerminal",
            "args": [
                "--conf", "/home/fork.weewx/weewx.debug.conf",
            ],                                    
        },        
    ]
}